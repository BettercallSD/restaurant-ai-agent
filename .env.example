# Copy to .env and fill in real values. Never commit .env.

# Main database (used by the app and `npm run migrate`)
DATABASE_URL=postgres://user:password@localhost:5432/restaurant_ai_agent

# Separate database used only by the automated test suite (npm test) — never point this at
# the same database as DATABASE_URL, tests assume they own the whole schema.
DATABASE_URL_TEST=postgres://user:password@localhost:5432/restaurant_ai_agent_test

PORT=3000
NODE_ENV=development

# Signing secret for staff/dashboard JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=15m

# Signing secret for session-scoped AI tool tokens. Keep distinct from JWT_SECRET so a leak of
# one does not also compromise the other.
AI_SESSION_SECRET=replace-with-a-different-long-random-value
