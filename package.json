{
  "name": "restaurant-ai-agent",
  "version": "0.1.0",
  "description": "Backend for an AI restaurant phone agent (reservations, orders, AI tool layer)",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "migrate:test": "cross-env DATABASE_URL=$DATABASE_URL_TEST node-pg-migrate up",
    "seed": "node src/db/seed.js",
    "test": "cross-env DATABASE_URL=$DATABASE_URL_TEST NODE_ENV=test jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=unit"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.6.1",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
